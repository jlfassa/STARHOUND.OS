<UserControl x:Class="STARHOUND.OS.UI.Galaxy.GalaxyMap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Border 
        Background="#020507"
        BorderBrush="#00E5FF"
        BorderThickness="2">


        <Grid>


            <TextBlock

                Text="GALAXY MAP ONLINE"

                Foreground="#00E5FF"

                FontSize="32"

                FontFamily="Consolas"

                HorizontalAlignment="Center"

                VerticalAlignment="Center"/>



            <Canvas>


                <Ellipse

                    Width="25"
                    Height="25"

                    Fill="#00E5FF"

                    Canvas.Left="300"

                    Canvas.Top="200"/>



                <Ellipse

                    Width="25"
                    Height="25"

                    Fill="#FFAA00"

                    Canvas.Left="600"

                    Canvas.Top="400"/>



            </Canvas>


        </Grid>


    </Border>


</UserControl>