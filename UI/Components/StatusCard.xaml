<UserControl x:Class="STARHOUND.OS.UI.Components.StatusCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Border

        Background="{StaticResource PanelLightBrush}"

        BorderBrush="{StaticResource CyanBrush}"

        BorderThickness="1"

        CornerRadius="6"

        Padding="12"

        Margin="6">


        <StackPanel>


            <TextBlock

                x:Name="TitleText"

                Text="SYSTEM"

                FontSize="14"

                Foreground="{StaticResource CyanBrush}"/>



            <TextBlock

                x:Name="ValueText"

                Text="ONLINE"

                FontSize="24"

                Margin="0,5,0,5"

                Foreground="White"/>





            <ProgressBar

                x:Name="StatusBar"

                Height="6"

                Minimum="0"

                Maximum="100"

                Value="75"

                Background="#020509"

                Foreground="{StaticResource CyanBrush}"/>


        </StackPanel>


    </Border>


</UserControl>